+
 		# create patch for manual source changes
 		[[ $CREATE_PATCHES == yes ]] && userpatch_create "u-boot"
 
@@ -371,6 +376,8 @@
 
 compile_kernel()
 {
+	# NATIVE_ARM64_KERNEL_DTC_FIX: use kernel-built dtc, not host dtc
+	unset DTC
 	if [[ $CLEAN_LEVEL == *make* ]]; then
 		display_alert "Cleaning" "$LINUXSOURCEDIR" "info"
 		(cd ${LINUXSOURCEDIR}; make ARCH="${ARCHITECTURE}" clean >/dev/null 2>&1)
--- a/scripts/debootstrap.sh
+++ b/scripts/debootstrap.sh
@@ -655,6 +655,13 @@
 	check_loop_device "$LOOP"
 
 	losetup -P $LOOP ${SDCARD}.raw
+	# NATIVE_ARM64_LOOP_FIX: ensure partition device nodes exist inside chroot
+	partprobe $LOOP >/dev/null 2>&1 || true
+	for _i in 1 2 3 4 5 6; do [ -b ${LOOP}p1 ] && break; sleep 1; done
+	if [ ! -b ${LOOP}p1 ]; then
+		local _d=$(cat /sys/block/$(basename $LOOP)/$(basename $LOOP)p1/dev 2>/dev/null)
+		if [ -n "$_d" ]; then mknod ${LOOP}p1 b ${_d%:*} ${_d#*:} 2>/dev/null || true; fi
+	fi
 
 	# loop device was grabbed here, unlock
 	flock -u $FD
