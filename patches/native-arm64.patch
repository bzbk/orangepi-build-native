--- a/scripts/compilation.sh
+++ b/scripts/compilation.sh
@@ -188,6 +188,11 @@
 
 		advanced_patch "u-boot" "$BOOTPATCHDIR" "$BOARD" "$target_patchdir" "$BRANCH" "${LINUXFAMILY}-${BOARD}-${BRANCH}"
 
+		# NATIVE_ARM64_UBOOT_FIX: vendor tree ships x86 dtc binary and uses -Werror
+		[ -x /usr/bin/dtc ] && export DTC=/usr/bin/dtc
+		sed -i "s/ -Werror$/ -Wno-error/" Makefile 2>/dev/null || true
